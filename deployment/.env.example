# Copy to .env and fill in the blanks. .env is gitignored; never commit real secrets.
# dotenv syntax is KEY=VALUE (no colons, no spaces around =).
#
# The DB/Redis passwords below are the SINGLE source: they configure the mariadb/redis containers
# AND are injected into the API's connection strings by docker-compose. The API's other settings
# (CORS, Admin, migrations, ...) live in the mounted appsettings.Production.local.json.

# ── Common ──────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh
ASPNETCORE_ENVIRONMENT=Production

# ── Images (registry + pinned version tags) ─────────────────────────────────
# GitHub Actions (.github/workflows/ci.yml) BUILDS AND PUSHES both images — you no
# longer run `docker compose build && push` by hand. Each service is published as
# <REGISTRY>/fairsharemon-<svc>:<TAG>, and api/web are tagged independently so a
# web-only release never re-tags api.
#
# What CI publishes:
#   git push origin api-v1.4.0  ->  fairsharemon-api:1.4.0, :1.4, :latest, :sha-<sha>
#   git push origin web-v2.1.0  ->  fairsharemon-web:2.1.0, :2.1, :latest, :sha-<sha>
#   merge to master             ->  :edge, :sha-<sha>   (never :latest)
#   pull request                ->  built only, nothing pushed
#
# So `latest` is always the newest RELEASE, and `edge` is the tip of master.
#
# The values below are what THIS host runs. Options, best first:
#   1.4.0        pin an exact release  (RECOMMENDED — reproducible, rollback is trivial)
#   latest       always take the newest release  (no .env edit per deploy)
#   edge         track master, for a staging host
#   sha-abc1234  pin one specific commit's build
#
# An "update pack" = set the version of the service you shipped, then on this host:
#   docker compose pull && docker compose up -d
# Rollback = set the version back to any previously published tag and re-pull.
REGISTRY=docker-registry.minhkakart.com
API_VERSION=1.0.0
WEB_VERSION=1.0.0

# ── Web (build-time; Vite inlines VITE_* into the bundle) ────────────────────
# Only used by a LOCAL `docker compose build web`. When CI builds the image it reads
# the same value from the GitHub repository variable VITE_API_BASE_URL — keep the two
# in sync, since the origin is baked into the bundle and cannot be changed at runtime.
# Production API origin the browser calls directly.
VITE_API_BASE_URL=https://fairsharemon-api.minhkakart.com
# Browser MSW mocking. Leave false in production.
VITE_ENABLE_MOCKS=false

# ── MariaDB (root password for the db container) ────────────────────────────
MARIADB_ROOT_PASSWORD=

# ── Redis (auth password for the redis container) ───────────────────────────
REDIS_PASSWORD=
